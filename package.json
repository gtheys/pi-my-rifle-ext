{
  "name": "pi-my-rifle-ext",
  "version": "0.1.0",
  "private": true,
  "description": "Personal pi extensions, skills, commands, and themes",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install || true",
    "format": "bunx @biomejs/biome check --write .",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun run --workspaces --if-present test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "release": "npm publish --workspaces --access public",
    "release:dry-run": "npm publish --workspaces --access public --dry-run"
  },
  "pi": {
    "extensions": [
      "./packages/pi-bootstrap/index.ts",
      "./packages/pi-ask-user-question/index.ts",
      "./packages/pi-prompt-snippets/index.ts",
      "./packages/pi-review/review/review.ts",
      "./packages/pi-review/sonarqube/sonarqube.ts",
      "./packages/pi-review/pr-quality/index.ts",
      "./packages/pi-test-runner/index.ts",
      "./packages/pi-interactive-subagents/pi-extension/subagents/index.ts",
      "./packages/pi-fastcontext/index.ts",
      "./packages/pi-planning/plan-tools/index.ts",
      "./packages/pi-planning/implement-plan/index.ts",
      "./packages/pi-sem/index.ts",
      "./packages/pi-tool-pills/index.ts",
      "./packages/pi-desktop-notify/index.ts",
      "./packages/pi-teams-transcript/index.ts",
      "./packages/pi-pr-digest/index.ts",
      "./packages/pi-worktree/index.ts",
      "./packages/pi-sudo/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-server": "0.85.0",
    "@gtheys/pi-per-commit-spend": "^0.2.6",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.85.1",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@^0.85.1",
    "@shikijs/cli": "^4.4.3",
    "@sting8k/pi-vcc": "^0.7.2",
    "@tomooshi/caveman-milk-pi": "^0.2.0",
    "@tomooshi/condensed-milk-pi": "^1.9.0",
    "diff": "^9.0.0",
    "graphify-pi": "^0.3.0",
    "pi-intercom": "^0.13.0",
    "pi-session-switch": "^0.4.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@biomejs/biome": "2.5.12",
    "@types/diff": "^8.0.0",
    "lefthook": "2.1.12",
    "typescript": "7.0.2",
    "bun-types": "^1.4.2"
  }
}
