      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "PBFA97CFB590B2093"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (ref) (pi_flow_tokens_total{mode=~\"${mode:raw}\", ref=~\"$ref\", agent=\"main\", kind=\"cacheRead\"}) / sum by (ref) (pi_flow_tokens_total{mode=~\"${mode:raw}\", ref=~\"$ref\", agent=\"main\", kind=~\"input|cacheRead|cacheWrite\"}) and on (ref) (push_time_seconds{job=\"pi-flow\", mode=~\"${mode:raw}\"} \u003e= (time() - $__range_s))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "renameByName": {
                        "Value": "Cache hit ratio",
                        "ref": "Name"
                      }
                    }
                  }
                },
                {
                  "group": "filterFieldsByName",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "Name",
                          "Cache hit ratio"
                        ]
                      }
                    }
                  }
                },
                {
                  "group": "sortBy",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "fields": {},
                      "sort": [
                        {
                          "desc": true,
                          "field": "Cache hit ratio"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "description": "cacheRead / (input + cacheRead + cacheWrite) of the orchestrator's own calls. Cache reads cost a fraction of fresh input; a low ratio on an expensive ticket is where to look first.",
          "id": 8,
          "links": [],
          "title": "Orchestrator cache hit ratio per ticket (higher = cheaper)",
          "vizConfig": {
            "group": "barchart",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
