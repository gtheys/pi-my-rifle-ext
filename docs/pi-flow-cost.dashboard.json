                      "mode": "outer"
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "renameByName": {
                        "Value #A": "Highest",
                        "Value #B": "Average",
                        "Value #C": "Median"
                      }
                    }
                  }
                },
                {
                  "group": "filterFieldsByName",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "include": {
                        "pattern": "^(role|Highest|Average|Median)$"
                      }
                    }
                  }
                },
                {
                  "group": "sortBy",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "fields": {},
                      "sort": [
                        {
                          "desc": true,
                          "field": "Highest"
                        }
                      ]
                    }
                  }
                }
              ]
            }
