{
  "name": "@gtheys/pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in herdr background tabs",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "HazAT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtheys/pi-my-rifle-ext.git",
    "directory": "packages/pi-interactive-subagents"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./pi-extension/subagents/index.ts",
      "default": "./pi-extension/subagents/index.ts"
    },
    "./subagents": {
      "types": "./pi-extension/subagents/index.ts",
      "default": "./pi-extension/subagents/index.ts"
    }
  },
  "files": [
    "pi-extension",
    "agents",
    "skills",
    "README.md",
    "config.json.example",
    "config.schema.json"
  ],
  "scripts": {
    "test": "node --test test/test.ts test/herdr-stderr.test.ts",
    "test:integration": "node --test --test-concurrency=1 --test-force-exit test/integration/*.test.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^1.4.0",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@^1.4.0",
    "@sinclair/typebox": "^0.34.49"
  }
}
